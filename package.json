{
  "name": "dsh-ai-workbench",
  "version": "0.8.3",
  "type": "module",
  "description": "用一句大白话，让 AI 在 DSH 里为你造一个窗口：侧边栏工作台先问几个问题，模型生成单文件 HTML 产物，窗口自动挂载；页面里声明的操作会被记进项目日志给你看，但不会自动送到模型；还能导入导出、一键装市场里的工作台。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uid-762/dsh-ai-workbench.git"
  },
  "homepage": "https://github.com/Uid-762/dsh-ai-workbench#readme",
  "bugs": {
    "url": "https://github.com/Uid-762/dsh-ai-workbench/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ai-workbench",
    "ai-agent",
    "react"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "locale/",
    "README.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "css": "node scripts/css-types.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "build": "node scripts/clean.mjs && node scripts/css-types.mjs && tsc -p tsconfig.json && tsdown",
    "watch": "tsdown --watch",
    "verify": "node scripts/verify.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "lightningcss": "^1.25.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.0-rc.2"
  }
}
